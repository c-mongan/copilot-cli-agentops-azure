{
  "name": "copilot-agentops-cli",
  "version": "0.3.3-preview",
  "description": "Local utilities for Copilot CLI AgentOps for Azure.",
  "files": [
    "LICENSE",
    "README.md",
    "actioner",
    "benchmark-judges",
    "benchmark-runners",
    "azure.yaml",
    "collector",
    "copilot",
    "docs",
    "examples",
    "evals",
    "fixtures",
    "grafana",
    "infra",
    "instrumentation",
    "kql",
    "install-agentops.ps1",
    "install-agentops.sh",
    "packages",
    "plugin",
    "scripts",
    "workbooks",
    "src",
    "uninstall-agentops.ps1",
    "uninstall-agentops.sh"
  ],
  "bin": {
    "agentops": "src/index.js"
  },
  "scripts": {
    "test": "node ../scripts/run-cli-tests.js",
    "coverage": "node ../scripts/run-cli-tests.js --experimental-test-coverage",
    "coverage:check": "node ../scripts/coverage-check.js",
    "static:check": "node ../scripts/static-check.js",
    "prepack": "node ../scripts/prepare-cli-package-assets.js copy",
    "postpack": "node ../scripts/prepare-cli-package-assets.js clean",
    "publish:check": "node ../scripts/check-cli-publish.js",
    "doctor": "node src/index.js doctor --local-only",
    "scan": "node src/index.js scan"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
