union isfuzzy=true AgentOpsInsights_CL
| where TimeGenerated between ($__timeFrom() .. $__timeTo())
| project
    TimeGenerated,
    InsightType,
    Severity,
    Summary,
    RunId,
    RepoHash,
    ModelActual,
    ToolName,
    BaselineValue,
    CurrentValue,
    ConfigHash,
    PatternId,
    PatternKey,
    PatternRuns,
    PatternDimension,
    SuggestedNextStep,
    Rule,
    ArchitectureVersion,
    Numerator,
    Denominator,
    CoverageRuns,
    Status,
    ComponentRefs,
    Evidence
| order by TimeGenerated desc
